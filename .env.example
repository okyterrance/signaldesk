# SignalDesk · environment template
#
#   cp .env.example .env     then fill in the three values below.
#
# .env is gitignored. Never commit real keys.

# ======================================================================
# REQUIRED · Telegram
# ======================================================================

# Bot token from @BotFather (Telegram) -> /newbot -> follow prompts.
# Free, takes about 30 seconds.
TELEGRAM_BOT_TOKEN=

# Chat/channel the scheduled digest and alerts are pushed to.
# Don't know it? Run:  python scripts/get_chat_id.py
# (send your bot any message first, then run the script)
TELEGRAM_CHAT_ID=

# ======================================================================
# REQUIRED · LLM
# ======================================================================

# TokenRouter is an OpenAI-compatible proxy; one key fans out to several
# model families with automatic fallback.
TOKENROUTER_API_KEY=

# ======================================================================
# OPTIONAL · tuning (sane defaults in src/config.py, override only if needed)
# ======================================================================

# Model fallback chain, first to return valid output wins.
# Slugs are specific to your key's plan -- run
#   python scripts/list_models.py
# to see what yours can call. Pick two from different vendors.
# LLM_MODEL_CHAIN=moonshotai/kimi-k3,x-ai/grok-4.3

# Daily digest push time, HH:MM in DIGEST_TZ.
# DIGEST_TIME=08:30
# DIGEST_TZ=Asia/Hong_Kong

# Realtime alert: any story scoring at/above this (0..1) is pushed
# immediately instead of waiting for the digest.
# ALERT_THRESHOLD=0.72
# ALERT_POLL_MINUTES=15

# How far back the feeds are read, in hours.
# NEWS_WINDOW_H=24

# ======================================================================
# NO KEY NEEDED
# ======================================================================
# 12 RSS feeds (CoinDesk / The Block / DL News / Unchained / The Defiant /
# Decrypt / FT / CNBC / Bloomberg / SCMP / CNA / ECB), Binance public
# price API, and the alternative.me Fear & Greed index are all free and
# unauthenticated. No signup, no quota, no billing.
